# Local development configuration for both map pages (BigQuery).
#
# Copy to `.env` (Git-ignored) and adjust if your tables move:
#     cp .env.example .env
#
# These are non-sensitive identifiers only. Credentials are NEVER stored here -
# they come from Application Default Credentials:
#     gcloud auth application-default login
#
# Real environment variables always take precedence over this file, and Cloud Run
# sets them directly (see .github/workflows/deploy-cloud-run.yml).

BIGQUERY_PROJECT_ID=maddictdata
BIGQUERY_DATASET=OOH_Analysis
# Page 1 (two-hour). These tables carry an INT64 hour_bucket column
# holding the two-hour period of the day: 0, 2, 4 ... 22.
BIGQUERY_OVERALL_INDEX_TABLE=h3_analysis_indexed_filtered
BIGQUERY_VOLUME_INDEX_TABLE=h3_analysis_volume_index_filtered
BIGQUERY_EXCLUSIVITY_INDEX_TABLE=h3_analysis_exclusivity_index_filtered

# Page 2 (day-part). Same project/dataset as above; separate tables that add
# an `hour_bucket` (Morning/Noon/After noon/Night/Other) column.
BIGQUERY_OVERALL_INDEX_DAY_SECTIONS_TABLE=h3_analysis_indexed_filtered_day_sections
BIGQUERY_VOLUME_INDEX_DAY_SECTIONS_TABLE=h3_analysis_volume_index_filtered_day_sections
BIGQUERY_EXCLUSIVITY_INDEX_DAY_SECTIONS_TABLE=h3_analysis_exclusivity_index_filtered_day_sections

# Project that query JOBS are billed to. Defaults to BIGQUERY_PROJECT_ID above.
# Set this only when jobs must be billed to a different project from the tables;
# without it the client would fall back to whatever project `gcloud` defaults
# to, which fails with a bigquery.jobs.create permission error naming a project
# you never configured. The account needs roles/bigquery.jobUser here.
# BIGQUERY_BILLING_PROJECT=maddictdata

# Basemap. The default detailed style (streets, buildings, labels, shaded
# relief) is token-free and needs no configuration. Point this at any MapLibre
# style.json URL to use your own provider - that is also where a provider key
# belongs, never in source.
# H3_BASEMAP_STYLE_URL=https://api.maptiler.com/maps/outdoor/style.json?key=YOUR_KEY

# Uncomment to default the sidebar to the synthetic local CSV instead of BigQuery.
# H3_DATA_SOURCE=local
