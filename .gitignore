.venv/
# Backup/parallel environments too: a virtualenv can cache tokens, and it is
# never something this repository should carry.
.venv*/
__pycache__/
*.pyc
.streamlit/secrets.toml

# Local config (identifiers only); .env.example is the committed template.
.env

# Never commit Google Cloud service-account keys.
*-service-account*.json
gcp-key*.json

# Production map exports stay local; keep folders via .gitkeep.
# The synthetic data/sample_index.csv and data/sample_index_day_sections.csv
# are committed on purpose for local dev/tests.
# data/map_2/*.csv was the old, no-day-part, two-file Page 2 CSV fallback.
# Page 2 is now BigQuery-first (see CLAUDE.md); the rule is kept only in case
# a real per-metric day-section CSV export is ever dropped there again.
data/map_2/*.csv
# Local production exports for the removed map_1 (hourly user_count) and map_3
# (overall analysis index) views. Kept on disk, never committed.
data/map_1/*.csv
data/map_3/*.csv

# --- Credentials: defence in depth ---------------------------------------
# .env is listed above; this catches per-environment variants without hiding
# the committed template.
.env.*
!.env.example

# Streamlit secrets wherever they land, not just .streamlit/.
secrets.toml
**/secrets.toml

# Private keys and certificates.
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Google Cloud and other credential files. ADC and Workload Identity
# Federation are the supported paths - a key file here means something is
# already wrong, so make it unstageable rather than merely discouraged.
credentials*.json
*-credentials.json
*.credentials.json
service-account*.json
*service_account*.json
application_default_credentials.json
gha-creds-*.json
# OAuth client downloads keep this exact name straight out of the Cloud console.
client_secret*.json
# Any downloaded key, whatever it was renamed to.
*key.json
sa-*.json

# Local secret directories.
.secrets/
secrets/
